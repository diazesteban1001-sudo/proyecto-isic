# Datos de la competencia: no se versionan
data/

# Configuracion local de Claude Code (permisos por maquina)
.claude/settings.local.json

# Andamio de verificacion: servidor estatico para mirar informe/demo.html
# en el navegador. El entregable abre con doble clic, no lo necesita.
.claude/launch.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# PDF de verificacion visual del entregable: se regenera desde el .docx
informe/*.pdf

# Word del informe: se genera a pedido desde el borrador con
# .claude/skills/sintesis-consultoria/scripts/md_a_docx.py y no se versiona.
informe/*.docx

# Salida derivada de graphify: grafo regenerable, no entra al repo por ahora
graphify-out/

# Textos completos de fuentes con copyright o licencia desconocida (regla 3 de
# CLAUDE.md). En referencias/ se versiona solo su ficha; el texto va aqui, en
# local, para comprobar citas caracter a caracter.
referencias/_texto-completo/

# Respuestas del experimento de la actividad «Nada sin fuente» cuyo texto no
# autoriza redistribuirse (regla 3 de CLAUDE.md). Se versiona su ficha, en
# actividad-fuentes/respuestas/; el texto completo va aquí, solo en local.
actividad-fuentes/respuestas/_texto-completo/

# PDF de los entregables de la actividad «Nada sin fuente»: se versiona solo el
# .md, que es la fuente (retroalimentación del docente tras la sustentación).
# Si hace falta un PDF, se regenera en local con informe/md_a_pdf.py.
actividad-fuentes/entregables/*.pdf
