# Datos de la competencia: no se versionan
data/

# Configuracion local de Claude Code (permisos por maquina)
.claude/settings.local.json

# Andamio de verificacion: servidor estatico para mirar informe/demo.html
# en el navegador. El entregable abre con doble clic, no lo necesita.
.claude/launch.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# PDF de verificacion visual del entregable: se regenera desde el .docx
informe/*.pdf

# Salida derivada de graphify: grafo regenerable, no entra al repo por ahora
graphify-out/

# Textos completos de fuentes con copyright o licencia desconocida (regla 3 de
